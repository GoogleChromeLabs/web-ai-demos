{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "index.js",
    "parser.js",
    "renderer.js",
    "markdown-to-html.js",
    "render-stream.js",
    "safe-url.js"
  ]
}
